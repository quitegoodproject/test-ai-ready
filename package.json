{
  "name": "answerrail",
  "version": "1.2.7",
  "description": "4-in-1 AEO & GEO Platform, RFC 9110 Accept: text/markdown Next.js Middleware & Cloudflare Edge Reverse Proxy — serve clean Markdown to PerplexityBot, ClaudeBot & OAI-SearchBot with 100% static price/FAQ recall, /llms.txt & /.well-known/ai-catalog.json (ARD 1.0)",
  "main": "client/index.js",
  "types": "client/index.d.ts",
  "type": "module",
  "bin": {
    "ai-ready-cli": "bin/test-ai-ready.js",
    "test-ai-ready": "bin/test-ai-ready.js",
    "ai-crawler-check": "bin/test-ai-ready.js",
    "answerrail": "bin/test-ai-ready.js",
    "answerrail-action": "bin/github-action.js",
    "answerrail-mcp": "bin/mcp-server.js"
  },
  "exports": {
    ".": {
      "types": "./client/index.d.ts",
      "import": "./client/index.js"
    },
    "./next": {
      "types": "./client/index.d.ts",
      "import": "./client/index.js"
    },
    "./edge": {
      "types": "./client/index.d.ts",
      "import": "./client/index.js"
    }
  },
  "files": [
    "bin",
    "action.yml",
    "README.md",
    "client"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quitegoodproject/test-ai-ready.git"
  },
  "homepage": "https://answerrail.com",
  "scripts": {
    "dev": "wrangler dev",
    "build:css": "tsx scripts/build-css.ts",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:css && wrangler deploy --dry-run --outdir dist",
    "audit": "tsx scripts/audit.ts"
  },
  "keywords": [
    "nextjs",
    "markdown",
    "content-negotiation",
    "llm-crawler",
    "ai-agents",
    "llms.txt",
    "llms-txt",
    "ai-catalog.json",
    "ard-1.0",
    "lighthouse-13.5",
    "agentic-browsing",
    "perplexitybot",
    "claudebot",
    "oai-searchbot",
    "chatgpt-search",
    "site-md",
    "next-md-negotiate",
    "ai-crawler-check",
    "test-ai-ready",
    "answerrail",
    "geo",
    "aeo",
    "seo",
    "cloudflare-workers",
    "rfc-9110"
  ],
  "author": "The Quite Good Project <engineering@quitegoodproject.com>",
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^4.5.3",
    "hono": "^4.7.1",
    "linkedom": "^0.18.9",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^22.13.5",
    "@types/turndown": "^5.0.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^3.111.0"
  }
}
