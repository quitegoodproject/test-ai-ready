{
  "name": "test-ai-ready",
  "version": "1.2.0",
  "description": "4-in-1 AEO & GEO Platform: Free AI Readiness Grader, /llms.txt & Schema Compiler, Crawler Attribution & Edge Reverse Proxy for WordPress, Shopify, Webflow, Static HTML & Next.js",
  "main": "client/index.js",
  "types": "client/index.d.ts",
  "type": "module",
  "bin": {
    "test-ai-ready": "bin/test-ai-ready.js",
    "answerrail": "bin/test-ai-ready.js",
    "answerrail-action": "bin/github-action.js",
    "answerrail-mcp": "bin/mcp-server.js"
  },
  "exports": {
    ".": {
      "types": "./client/index.d.ts",
      "import": "./client/index.js"
    },
    "./next": {
      "types": "./client/index.d.ts",
      "import": "./client/index.js"
    },
    "./edge": {
      "types": "./client/index.d.ts",
      "import": "./client/index.js"
    }
  },
  "files": [
    "bin",
    "action.yml",
    "README.md",
    "client"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quitegoodproject/test-ai-ready.git"
  },
  "homepage": "https://answerrail.com",
  "scripts": {
    "dev": "wrangler dev",
    "build:css": "tsx scripts/build-css.ts",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:css && wrangler deploy --dry-run --outdir dist",
    "audit": "tsx scripts/audit.ts"
  },
  "keywords": [
    "rfc-2602",
    "geo",
    "aeo",
    "ai-search",
    "answer-engine",
    "reverse-proxy",
    "cloudflare-workers",
    "llms-txt",
    "markdown",
    "perplexity",
    "chatgpt"
  ],
  "author": "The Quite Good Project <engineering@quitegoodproject.com>",
  "license": "MIT",
  "dependencies": {
    "fast-xml-parser": "^4.5.3",
    "hono": "^4.7.1",
    "linkedom": "^0.18.9",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^22.13.5",
    "@types/turndown": "^5.0.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^3.111.0"
  }
}
